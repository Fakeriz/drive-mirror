# Salin jadi .env lalu isi. JANGAN commit file .env ke repo!

# ================= MODE TAMU (tanpa login) =================
# Isi JSON service account dalam SATU baris.
# Cara dapat: Google Cloud Console -> IAM & Admin -> Service Accounts
# -> buat account -> Keys -> Add Key -> JSON.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ID folder tujuan mode tamu. WAJIB folder di Shared Drive
# (service account tidak punya kuota penyimpanan sendiri).
# Tambahkan email service account sebagai member (Content manager) di Shared Drive itu.
# Catatan: agar link tamu bisa dibuka publik, sharing Shared Drive harus
# mengizinkan "anyone with link" (atau biarkan kosong = root Drive app).
DRIVE_FOLDER_ID=

# Batas ukuran file mode tamu (MB). Mencegah penyalahgunaan kuota Drive app.
GUEST_MAX_MB=500

# ================= DRIVE SAYA (login Google / OAuth) =================
# Cara dapat: Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application.
# Tambahkan Authorized redirect URI persis seperti OAUTH_REDIRECT_URI di bawah.
# Aktifkan juga "Google Drive API" di APIs & Services -> Library.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Kunci acak untuk session login (wajib diisi di production).
# Contoh: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ================= UMUM =================
# Opsional: token sederhana supaya API tidak dipakai orang lain.
# Kalau diisi, form web & API wajib kirim header: Authorization: Bearer <token>
MIRROR_TOKEN=

PORT=8000
